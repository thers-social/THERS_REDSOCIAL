# Cabeceras de Cloudflare Pages para la web (Sprint 1 de endurecimiento).
# Las aplica el hosting estático; no existen en `npm run dev`.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # CSP en modo SOLO INFORME: no bloquea nada, solo reporta en la consola del navegador.
  # Revisar violaciones en staging (Google Fonts, Google Identity, imágenes del bucket) y,
  # cuando salga limpio, renombrar a `Content-Security-Policy`.
  # Ajustar `connect-src`/`img-src` a los dominios reales de la API y del bucket.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.thersweb.com https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Los archivos de /assets llevan hash en el nombre: se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
