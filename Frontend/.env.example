# Variables de entorno del Frontend — copiar a .env y ajustar valores locales.
# .env nunca se sube al repositorio (HB-001 §19.1/§20, regla innegociable).
# Vite solo expone al cliente las variables con prefijo VITE_.

# URL base de la API del backend (incluye el prefijo /api).
# Si no se define, Frontend/src/shared/lib/api.js usa http://127.0.0.1:5000/api
# y lo advierte por consola.
VITE_API_URL=http://127.0.0.1:5000/api

# "Continuar con Google" (ADR-012-google-sign-in.md). Client ID de OAuth
# creado en Google Cloud Console (Credentials > OAuth client ID > Web
# application) -- NO es secreto, es el mismo valor que
# GOOGLE_CLIENT_ID en backend/.env.example (el backend lo usa como `aud`
# esperada al verificar el ID Token). Sin esta variable,
# GoogleSignInButton.jsx no puede inicializar Google Identity Services --
# lo advierte por consola, sin romper el resto del formulario de
# Login/Register.
VITE_GOOGLE_CLIENT_ID=

# Dominio público del sitio, SIN barra final (ej. https://thers.example).
# Lo usan el build (robots.txt y sitemap.xml con URLs absolutas) y RouteSeo.jsx
# (<link rel="canonical">). Solo en producción: sin esta variable el build genera
# un robots.txt que NO deja indexar nada y omite el sitemap
# (ADR-033-seo-foundation.md).
VITE_SITE_URL=

# Estilo del mapa de THERS Places (ADR-040-thers-places.md §4.6): URL de un estilo MapLibre/Mapbox GL
# de TU proveedor de tiles (Stadia, MapTiler, Geoapify…). Cambiar de proveedor es cambiar esta variable.
# Si el proveedor exige clave, va dentro de la URL y queda en el bundle: usa una clave RESTRINGIDA por
# dominio, nunca un secreto. Sin esta variable se usa el estilo de demostración de MapLibre (solo sirve
# para desarrollo: no tiene calles) y se advierte por consola. La decisión del proveedor (D1) sigue
# pendiente. Añade también su dominio al CSP de public/_headers.
VITE_MAP_STYLE_URL=

# Tero, el asistente de THERS (ADR-041). Encendido salvo que valga exactamente "false": la burbuja
# de Tero solo aparece con sesión iniciada y habla con el servidor real (POST /api/tero/chat).
# El servidor tiene sus propios interruptores (TERO_ENABLED, TERO_AI_ENABLED...); con este
# encendido y el servidor apagado solo se muestra «Tero no está disponible». No es un secreto.
VITE_TERO_ENABLED=true
# Preguntas a Tero con una imagen (ADR-046): botón de imagen en el chat. Apagado salvo que valga
# exactamente "true": la imagen se envía a Anthropic y cuesta por uso. El servidor tiene su propio
# interruptor (TERO_IMAGES_ENABLED).
VITE_TERO_IMAGES_ENABLED=false

# Notas de voz en mensajes (ADR-042). Apagado salvo que valga exactamente "true". El servidor tiene
# su propio interruptor (VOICE_MESSAGES_ENABLED); con este encendido y el servidor apagado, enviar
# muestra «Las notas de voz no están disponibles ahora». El micrófono solo funciona en https o
# localhost. No es un secreto.
VITE_VOICE_ENABLED=false
# Videos cortos en publicaciones y mensajes (ADR-046): botón «Video» y reproductor. Apagado salvo que
# valga exactamente "true". El servidor tiene su propio interruptor (VIDEO_UPLOADS_ENABLED); con este
# encendido y el servidor apagado, enviar muestra «Los videos no están disponibles ahora».
VITE_VIDEO_ENABLED=false

# Dictado para Tero (ADR-042 §1.2): hablar y que se escriba en el campo de Tero. Usa el
# reconocimiento de voz del navegador (en Chrome lo procesa Google, en Safari Apple); el audio no
# llega a THERS. Apagado salvo que valga exactamente "true".
VITE_TERO_VOICE_ENABLED=false
