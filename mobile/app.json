{
  "expo": {
    "name": "THERS",
    "slug": "thers",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "thers",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.thers.app",
      "adaptiveIcon": {
        "backgroundColor": "#7c3aed",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thers.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "THERS usa tu ubicación aproximada solo cuando pulsás «Usar mi ubicación», para mostrarte lugares cercanos. No se guarda."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "THERS accede a tus fotos solo para que elijas la imagen de una historia."
        }
      ],
      "expo-video"
    ]
  }
}
