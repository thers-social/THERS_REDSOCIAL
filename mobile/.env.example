# Variables de entorno de la app móvil — copiar a `mobile/.env` y ajustar.
# `.env` NUNCA se sube al repositorio (HB-001 §20, regla innegociable).
#
# ⚠️ Todo lo que lleve el prefijo EXPO_PUBLIC_ queda EMBEBIDO EN EL BUNDLE y es
# legible por cualquiera que tenga el APK. Está bien para una URL. NUNCA poner
# acá JWT_SECRET_KEY, DATABASE_URL, RESEND_API_KEY, claves S3 ni secretos de
# LiveKit: esos viven exclusivamente en el servidor.

# URL base de la API, con el prefijo /api incluido (igual que VITE_API_URL en
# el Frontend web).
#
# En un TELÉFONO FÍSICO, `localhost` y `127.0.0.1` apuntan al propio teléfono:
# hay que usar la IP LAN del equipo de desarrollo. El emulador estándar de
# Android usa 10.0.2.2 para alcanzar el host.
#
# Ver docs/mobile/ANDROID_SETUP.md §5 (incluye la regla de firewall necesaria).
# Si no se define, src/shared/lib/api.ts usa http://127.0.0.1:5000/api y lo
# advierte por consola.
EXPO_PUBLIC_API_URL=http://192.168.1.69:5000/api

# Tero, la mascota y asistente (docs/tero/). Vista previa de la fase 1: interfaz
# con datos de ejemplo, sin IA. Apagado salvo que valga exactamente `true`.
# Es un interruptor, no un secreto (queda embebido en el bundle como toda
# EXPO_PUBLIC_*).
EXPO_PUBLIC_TERO_ENABLED=false
