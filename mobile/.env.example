# Variables de entorno de la app móvil — copiar a `mobile/.env` y ajustar.
# `.env` NUNCA se sube al repositorio (HB-001 §20, regla innegociable).
#
# ⚠️ Todo lo que lleve el prefijo EXPO_PUBLIC_ queda EMBEBIDO EN EL BUNDLE y es
# legible por cualquiera que tenga el APK. Está bien para una URL. NUNCA poner
# acá JWT_SECRET_KEY, DATABASE_URL, RESEND_API_KEY, claves S3 ni secretos de
# LiveKit: esos viven exclusivamente en el servidor.

# URL base de la API, con el prefijo /api incluido (igual que VITE_API_URL en
# el Frontend web).
#
# En un TELÉFONO FÍSICO, `localhost` y `127.0.0.1` apuntan al propio teléfono:
# hay que usar la IP LAN del equipo de desarrollo. El emulador estándar de
# Android usa 10.0.2.2 para alcanzar el host.
#
# Ver docs/mobile/ANDROID_SETUP.md §5 (incluye la regla de firewall necesaria).
# Si no se define, src/shared/lib/api.ts usa http://127.0.0.1:5000/api y lo
# advierte por consola.
EXPO_PUBLIC_API_URL=http://192.168.1.69:5000/api

# Estilo del mapa de THERS Places (ADR-040 §4.6): URL de un estilo MapLibre de TU proveedor de
# tiles. Cambiar de proveedor es cambiar esta variable.
#
# OJO: el móvil necesita SU PROPIA clave. La app nativa NO envía la cabecera `Origin`, así que
# la clave de la web (restringida por dominio) sería rechazada con 403. Crea una clave aparte
# para la app. Queda embebida en el APK: restríngela en el panel del proveedor (límite de uso,
# y por aplicación si el proveedor lo permite). Nunca pongas aquí un secreto.
#
# La URL debe terminar en `/style.json?key=...` (sin `style.json` devuelve una página web).
# Sin esta variable se usa el estilo de demostración de MapLibre (sin calles; solo desarrollo).
# El plan gratuito de MapTiler es solo no comercial: para publicar hace falta un plan de pago.
EXPO_PUBLIC_MAP_STYLE_URL=
# Tero, la mascota y asistente (docs/tero/). Vista previa de la fase 1: interfaz
# con datos de ejemplo, sin IA. Encendido salvo que valga exactamente `false`.
# Es un interruptor, no un secreto (queda embebido en el bundle como toda
# EXPO_PUBLIC_*).
EXPO_PUBLIC_TERO_ENABLED=true
# Conecta el chat de Tero al servidor real (POST /api/tero/chat, ADR-041) en vez de las
# respuestas de ejemplo. Requiere que el servidor tenga TERO_ENABLED y TERO_AI_ENABLED activos; si
# no, el chat muestra «Tero no está disponible». Las tarjetas de confirmación (seguir, dejar de
# seguir, editar nombre o biografía) solo aparecen si además el servidor tiene
# TERO_TOOLS_ENABLED y TERO_ACTIONS_ENABLED. Encendido salvo que valga exactamente `false`.
EXPO_PUBLIC_TERO_LIVE=true

# Videos cortos en publicaciones y mensajes (ADR-046): botón «Video» y reproductor. Apagado salvo que valga
# exactamente `true`. El servidor tiene su propio interruptor (VIDEO_UPLOADS_ENABLED); con este encendido
# y el servidor apagado, enviar muestra «Los videos no están disponibles ahora». No es un secreto.
EXPO_PUBLIC_VIDEO_ENABLED=false
# Preguntar a Tero con una imagen (ADR-046): botón «Foto» en el chat de Tero. Encendido salvo que valga
# exactamente `false`: la imagen se envía a Anthropic y cuesta por uso. El servidor tiene su propio
# interruptor (TERO_IMAGES_ENABLED).
EXPO_PUBLIC_TERO_IMAGES_ENABLED=true

# «Continuar con Google» (ADR-012, docs/mobile/ANDROID_SETUP.md §6): el Web client ID de OAuth, el MISMO valor
# que GOOGLE_CLIENT_ID del backend (el servidor acepta una sola audiencia). Es un identificador público, no un
# secreto: queda en el bundle. Además hace falta un cliente OAuth de tipo Android (paquete com.thers.app + SHA-1
# de la keystore) en el MISMO proyecto de Google Cloud. Sin esta variable el botón no se muestra.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Llamadas y videollamadas 1 a 1 (LiveKit). Encendido salvo que valga exactamente `false`. Es un interruptor, no un
# secreto (queda embebido en el bundle). El servidor tiene el suyo (CALLS_ENABLED) y las claves de LiveKit: con el
# servidor apagado, llamar muestra «Las llamadas no están disponibles ahora». Requiere una build nativa nueva.
EXPO_PUBLIC_CALLS_ENABLED=true
