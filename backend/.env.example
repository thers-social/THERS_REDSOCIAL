# Variables de entorno del backend — copiar a .env y ajustar valores locales.
# .env nunca se sube al repositorio (HB-001 §19.1/§20, regla innegociable).
# Ninguna variable de este archivo debe contener un secreto real.

# Clave usada para firmar los JWT emitidos por flask_jwt_extended.
# Si no se define AQUÍ, backend/app/config.py exige la variable de abajo
# (ALLOW_INSECURE_JWT_DEV_FALLBACK) para arrancar con un valor de desarrollo
# inseguro — ver BACKEND_ARCHITECTURE.md §20. Poner un valor real acá para
# dejar de depender del fallback, incluso en local.
JWT_SECRET_KEY=

# SOLO para desarrollo local: permite que config.py use un JWT_SECRET_KEY de
# desarrollo inseguro cuando la variable de arriba está vacía, en vez de
# fallar al arrancar. Viene en "1" acá para que `cp .env.example .env` siga
# funcionando sin pasos extra en local.
# NUNCA definir esta variable en Render ni en ningún entorno desplegado —
# quien la defina ahí está aceptando a propósito que cualquiera con acceso a
# este repositorio pueda firmar JWTs válidos para cualquier usuario.
ALLOW_INSECURE_JWT_DEV_FALLBACK=1

# Cadena de conexión a PostgreSQL, formato (driver psycopg v3 — nótese
# "+psycopg", no solo "postgresql://", ver requirements.txt):
# postgresql+psycopg://usuario:password@host:puerto/nombre_bd
# Sin esta variable, la app arranca pero cualquier operación contra la base de
# datos falla — no hay un valor de desarrollo por defecto que la sustituya (a
# diferencia de JWT_SECRET_KEY) porque no hay una base "de desarrollo" segura
# que asumir. Ver docs/architecture/DATABASE_ARCHITECTURE.md.
DATABASE_URL=

# --- Correo electrónico (Resend) — ADR-009-password-reset-and-email-verification.md ---
#
# Clave de API de Resend (https://resend.com/api-keys). Sin esta variable,
# infrastructure/email/resend_email_sender.py nunca se instancia -- el
# backend usa automáticamente un NullEmailSender que solo registra el
# intento de envío por log, sin fallar y sin llamar a Resend (mismo criterio
# de "fallback explícito, nunca silencioso en producción" que
# ALLOW_INSECURE_JWT_DEV_FALLBACK, ver config.py). Definir un valor real acá
# (una API key de modo test o de prueba de Resend, nunca de producción, sirve
# perfecto para desarrollo local) para probar el envío real end-to-end.
RESEND_API_KEY=

# Remitente ("from") de los correos de THERS. Con comillas, porque lleva un nombre
# visible y "<...>". Debe ser una dirección de un dominio VERIFICADO en Resend
# (SPF y DKIM): hoy `notificaciones.thersweb.com`. Resend rechaza (403) cualquier
# otro dominio, y a los dominios sin verificar solo les entrega al dueño de la
# cuenta. Para desarrollo sin dominio propio sirve "onboarding@resend.dev" (Resend lo
# ofrece para pruebas; solo entrega al correo del dueño de la cuenta de Resend).
# Reply-To todavía NO se configura: la recepción de soporte@thersweb.com no está lista.
EMAIL_FROM="THERS <avisos@notificaciones.thersweb.com>"

# Dirección a la que llegan las respuestas cuando alguien pulsa "Responder" en un correo
# de THERS (campo Reply-To). Debe ser un buzón que reciba correo: hoy soporte@thersweb.com,
# que Cloudflare Email Routing reenvía al correo administrativo. Vacío = no se envía Reply-To.
EMAIL_REPLY_TO=soporte@thersweb.com

# Origen del Frontend, usado para construir los enlaces que van dentro de los
# correos (recuperación de contraseña, verificación de email) --
# "<FRONTEND_URL>/reset-password?token=..." / "<FRONTEND_URL>/verify-email?token=...".
# Con el valor de abajo, esos enlaces apuntan al Frontend corriendo en local
# (`npm run dev`, ver Frontend/vite.config.js) -- ajustar a la URL real
# cuando el Frontend esté desplegado en otro origen.
FRONTEND_URL=http://localhost:5173

# --- "Continuar con Google" (ADR-012-google-sign-in.md) ---
#
# Client ID de OAuth 2.0 creado en Google Cloud Console (Credentials >
# Create Credentials > OAuth client ID > Web application). NO es secreto --
# es el mismo valor que VITE_GOOGLE_CLIENT_ID en Frontend/.env.example, el
# Frontend lo expone tal cual al inicializar Google Identity Services.
# infrastructure/auth/google_id_token_verifier.py lo usa como la `aud`
# exacta que cada ID Token debe tener -- sin esta variable, POST
# /api/auth/google arranca pero rechaza cualquier credencial real.
GOOGLE_CLIENT_ID=

# El Client Secret que Google Cloud Console entrega junto al Client ID NO
# se usa en este flujo (ADR-012 §Decisión: verificación de ID Token vía
# OpenID Connect, no el flujo de código de autorización con intercambio
# servidor-a-servidor) -- no hay una variable GOOGLE_CLIENT_SECRET en este
# archivo a propósito. Si un futuro proveedor (Apple, Microsoft) sí lo
# requiriera, se agregaría entonces, nunca hardcodeado.

# --- Imágenes de perfil (ADR-015-profile-media.md) ---
# local (default): guarda en backend/uploads y las sirve GET /api/media/...
# s3: Supabase Storage / Cloudflare R2 / S3 (obligatorio en cualquier entorno
# desplegado: el disco de los servicios en la nube es efímero).
STORAGE_BACKEND=local
# Solo local: carpeta de destino (por defecto backend/uploads).
UPLOAD_DIR=
# URL base con la que el navegador pide las imágenes (sin barra final).
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:5000/api/media
# Solo STORAGE_BACKEND=s3 (nunca subir valores reales al repositorio).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Sesión JWT (ADR-017-jwt-session-policy.md) ---
# Vida del access token (segundos, default 900 = 15 min) y del refresh token
# (días, default 30). Dejar vacías en producción. Útil bajar el access a ~30 s
# SOLO en local/staging para probar la renovación automática en un dispositivo.
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=
JWT_REFRESH_TOKEN_EXPIRES_DAYS=

# --- Términos de uso (ADR-032-content-reports-and-moderation.md §5) ---
# Versión vigente (una fecha de publicación). Si se deja vacía se usa la del
# código. Cambiarla obliga a todo el mundo a volver a aceptar.
TERMS_VERSION=
# 1 = el registro y el alta con Google exigen aceptar los términos. Dejar vacío
# hasta que el Frontend y la app móvil envíen la aceptación.
TERMS_ACCEPTANCE_REQUIRED=

# --- CORS (ADR-018-hosting-and-environments.md §Riesgos, ítem 5) ---
#
# Orígenes web que pueden llamar a la API desde un navegador, separados por comas, sin barra
# final: https://thersweb.com,https://staging.thersweb.com
# Vacía = abierto a cualquier origen: cómodo en local, NO dejarlo así en un entorno desplegado
# (el arranque lo advierte por stderr). La app móvil no usa CORS.
CORS_ORIGINS=

# --- Registro de errores (Sentry, opcional) ---
# Sin SENTRY_DSN no se envía nada. No se adjuntan datos personales (send_default_pii=False).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
